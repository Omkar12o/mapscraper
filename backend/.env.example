PORT=5000
SCRAPER_URL=http://localhost:8080
SCRAPER_MAX_TIME_SECONDS=300
SCRAPER_DEPTH=10
SCRAPER_RADIUS=10000
MAX_RETRIES=1
POLL_INTERVAL_MS=5000
CONCURRENCY=3
DB_PATH=./data/leadfinder.db

# Mail Sender (optional). Leave SMTP_HOST empty to disable sending.
# Gmail needs an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
# One-click unsubscribe link included in headers + footer (recommended).
MAIL_UNSUBSCRIBE_URL=
MAIL_DELAY_SECONDS=45
MAIL_DAILY_CAP=50

# SMS Sender (optional). Leave empty to configure it from the app instead.
# SMS_PROVIDER=fast2sms
# SMS_COUNTRY_CODE=91
# FAST2SMS_API_KEY=
# FAST2SMS_SENDER_ID=
# FAST2SMS_ROUTE=q
# FAST2SMS_TEMPLATE_ID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TextBelt (optional) — free daily tier for testing. API key from textbelt.com.
# TEXTBELT_API_KEY=
SMS_DELAY_SECONDS=15
SMS_DAILY_CAP=100
